{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	// Run `npx wrangler kv namespace create EMAILS_TEMP` and swap in the id
	// it prints — this one is tied to the original deployment's account.
	"kv_namespaces": [
		{
			"binding": "KV_NAME",
			"id": "your-kv-namespace-id",
		},
	],
}
