{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "EMAILS_TEMP",
			"id": "your-kv-namespace-id",
		},
	],
}
 